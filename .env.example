# =============================================================================
# SmartWake AI - Environment Variables Template
# =============================================================================
# Copy this file to .env and configure values for your environment.
# Never commit .env or secret API keys to version control.
# =============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./smartwake.db

# Generative AI Configuration (Phase 4)
# Master toggle for GenAI challenge content generation (true / false)
GENAI_ENABLED=false

# GenAI Provider: "mock" (offline testing/dev) or "gemini" (production)
GENAI_PROVIDER=mock

# External GenAI API Key (required when GENAI_PROVIDER is "gemini")
GENAI_API_KEY=

# GenAI Model Identifier (configurable, e.g., gemini-2.0-flash, gemini-2.5-flash)
GENAI_MODEL=gemini-2.0-flash

# Maximum seconds to wait for a GenAI provider response before falling back
GENAI_TIMEOUT_SECONDS=5.0

# Maximum provider retry attempts before falling back to catalog generation
GENAI_MAX_RETRIES=1

# Generation temperature (0.0 to 1.0)
GENAI_TEMPERATURE=0.7
